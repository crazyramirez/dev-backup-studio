<script>
// La página se pone al día sola: cuando un ordenador usa el código, cuando caduca o cuando una copia
// cambia de estado, se recarga (con el código en pantalla se pregunta cada 2 s; si no, cada 5 s).
(function () {
    var url = <?php echo json_encode((string)$this->statusUrl) ?>;
    var signature = <?php echo json_encode((string)$this->signature) ?>;
    var left = <?php echo $this->code ? (int)$this->code[1] : 0 ?>;
    var shown = document.getElementById('dbs-left');
    var reloading = false;

    function reload() {
        if (!reloading) {
            reloading = true;
            window.location.reload();
        }
    }

    function draw() {
        if (!shown) {
            return;
        }
        var s = Math.max(0, left);
        shown.textContent = Math.floor(s / 60) + ':' + ('0' + (s % 60)).slice(-2);
    }

    function bytes(n) {
        var units = ['B', 'KB', 'MB', 'GB', 'TB'], i = 0;
        while (n >= 1024 && i < units.length - 1) {
            n /= 1024;
            i += 1;
        }
        return (i ? n.toFixed(n < 10 ? 2 : 1) : n) + ' ' + units[i];
    }

    function poll() {
        if (reloading || document.hidden) {
            return;
        }
        var xhr = new XMLHttpRequest();
        xhr.open('GET', url + (url.indexOf('?') < 0 ? '?' : '&') + '_=' + Date.now(), true);
        xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
        xhr.onload = function () {
            if (xhr.status !== 200) {
                return;
            }
            try {
                var data = JSON.parse(xhr.responseText);
                if (data.signature && data.signature !== signature) {
                    reload();
                    return;
                }
                if (typeof data.code_left === 'number' && shown) {
                    left = data.code_left;
                    draw();
                }
                // copias en marcha: lo preparado y lo último que cuenta Plesk, sin recargar
                var running = data.running || {};
                Object.keys(running).forEach(function (id) {
                    var line = document.getElementById('dbs-line-' + id);
                    var prep = document.getElementById('dbs-prep-' + id);
                    if (line) {
                        line.textContent = running[id].line || '';
                    }
                    if (prep && running[id].prepared) {
                        prep.textContent = bytes(running[id].prepared);
                    }
                });
            } catch (err) {
                // la sesión de Plesk caducó (llega la página de inicio): no se insiste
            }
        };
        xhr.send();
    }

    if (left > 0) {
        setInterval(function () {
            left -= 1;
            draw();
            if (left <= 0) {
                reload();
            }
        }, 1000);
    }
    var busy = <?php echo json_encode((bool)array_filter($this->jobs, function ($j) { return in_array($j['state'], ['queued', 'running'], true); })) ?>;
    setInterval(poll, left > 0 || busy ? 2000 : 5000);
    document.addEventListener('visibilitychange', function () {
        if (!document.hidden) {
            poll();
        }
    });
})();
</script>
