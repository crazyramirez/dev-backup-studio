<?php
$e = function ($s) { return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8'); };
$m = function ($key, $args = []) { return pm_Locale::lmsg($key, $args); };
$when = function ($ts) { return $ts ? date('Y-m-d H:i', is_numeric($ts) ? (int)$ts : strtotime($ts)) : '—'; };
$size = function ($n) {
    $n = (float)$n;
    foreach (['B', 'KB', 'MB', 'GB', 'TB'] as $u) {
        if ($n < 1024 || $u === 'TB') {
            return ($u === 'B' ? (int)$n : number_format($n, $n < 10 ? 2 : 1)) . " $u";
        }
        $n /= 1024;
    }
};
?>
