                <?php foreach ($this->jobs as $j):
                    $cls = ['done' => 'dbs-ok', 'failed' => 'dbs-err', 'canceled' => 'dbs-muted'][$j['state']] ?? 'dbs-run';
                    $kind = $j['kind'] === 'backup' ? $m('kindBackup') : ($j['mode'] === 'server' ? $m('kindRestore') : $m('kindImport')); ?>
                <tr><td><?php echo $e($when($j['started'])) ?></td><td><?php echo $e($kind) ?></td>
