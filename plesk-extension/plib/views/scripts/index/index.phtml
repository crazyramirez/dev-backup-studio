                        <?php if ($j['state'] === 'failed' && $j['error']): ?><br><span class="dbs-muted"><?php echo $e($j['error']) ?></span><?php endif ?>
                        <?php if (in_array($j['state'], ['queued', 'running'], true)): ?><br><span class="dbs-muted dbs-mono" id="dbs-line-<?php echo $e($j['id']) ?>"><?php echo $e($j['line']) ?></span><?php endif ?></td>
                    <td><?php if (in_array($j['state'], ['queued', 'running'], true)): ?><span id="dbs-prep-<?php echo $e($j['id']) ?>"><?php echo $j['prepared'] ? $e($size($j['prepared'])) : '…' ?></span><?php else: ?><?php echo $j['size'] ? $e($size($j['size'])) : '—' ?><?php endif ?></td></tr>
