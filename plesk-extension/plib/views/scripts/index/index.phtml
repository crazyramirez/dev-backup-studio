<?php
$e = function ($s) { return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8'); };
$m = function ($key, $args = []) { return pm_Locale::lmsg($key, $args); };
$when = function ($ts) { return $ts ? date('Y-m-d H:i', is_numeric($ts) ? (int)$ts : strtotime($ts)) : '—'; };
$size = function ($n) {
    $n = (float)$n;
    foreach (['B', 'KB', 'MB', 'GB', 'TB'] as $u) {
        if ($n < 1024 || $u === 'TB') {
            return ($u === 'B' ? (int)$n : number_format($n, $n < 10 ? 2 : 1)) . " $u";
        }
        $n /= 1024;
    }
};
?>
<style>
.dbs { max-width: 980px; }
.dbs-box { border: 1px solid #d7dde3; border-radius: 8px; padding: 18px 22px; margin: 0 0 22px; background: #fff; }
.dbs-box h3 { margin: 0 0 10px; font-size: 16px; }
.dbs-code { font: 700 44px/1.1 monospace; letter-spacing: 8px; color: #28aade; margin: 6px 0 10px; }
.dbs-muted { color: #737f8c; }
.dbs-mono { font-family: monospace; word-break: break-all; }
.dbs table { border-collapse: collapse; width: 100%; }
.dbs th, .dbs td { text-align: left; padding: 6px 10px 6px 0; border-bottom: 1px solid #eef1f4; vertical-align: top; }
.dbs th { color: #737f8c; font-weight: 600; font-size: 12px; text-transform: uppercase; }
.dbs-ok { color: #2a9d5b; } .dbs-err { color: #d0383d; } .dbs-run { color: #28aade; }
</style>
<div class="dbs">
    <p><?php echo $e($m('intro')) ?>
        <a href="https://github.com/crazyramirez/dev-backup-studio/releases/latest" target="_blank" rel="noopener"><?php echo $e($m('getApp')) ?></a></p>
    <?php if (!$this->tools): ?>
        <div class="dbs-box dbs-err"><?php echo $e($m('noTools')) ?></div>
    <?php endif ?>

    <div class="dbs-box">
        <h3><?php echo $e($m('pairTitle')) ?></h3>
        <?php if ($this->code): ?>
            <p><?php echo $e($m('codeHelp')) ?></p>
            <div class="dbs-code"><?php echo $e(substr($this->code[0], 0, 3) . ' ' . substr($this->code[0], 3)) ?></div>
            <p class="dbs-muted"><?php echo $e($m('codeExpires', ['minutes' => max(1, (int)ceil($this->code[1] / 60))])) ?></p>
            <table>
                <tr><th style="width:220px"><?php echo $e($m('serverAddress')) ?></th><td class="dbs-mono"><?php echo $e($this->address) ?></td></tr>
                <?php if ($this->fingerprint): ?>
                <tr><th><?php echo $e($m('fingerprint')) ?></th><td class="dbs-mono"><?php echo $e($this->fingerprint) ?></td></tr>
                <?php endif ?>
            </table>
            <p class="dbs-muted"><?php echo $e($m('fingerprintHelp')) ?></p>
        <?php else: ?>
            <p><?php echo $e($m('pairHelp')) ?></p>
        <?php endif ?>
        <?php echo $this->pairForm ?>
    </div>

    <div class="dbs-box">
        <h3><?php echo $e($m('devicesTitle')) ?></h3>
        <?php if (!$this->devices): ?>
            <p class="dbs-muted"><?php echo $e($m('noDevices')) ?></p>
        <?php else: ?>
            <table>
                <tr><th><?php echo $e($m('colDevice')) ?></th><th><?php echo $e($m('colSince')) ?></th>
                    <th><?php echo $e($m('colLastSeen')) ?></th><th><?php echo $e($m('colIp')) ?></th></tr>
                <?php foreach ($this->devices as $d): ?>
                <tr><td><?php echo $e($d['name']) ?></td><td><?php echo $e($when($d['created'])) ?></td>
                    <td><?php echo $e($when($d['last_seen'])) ?></td><td class="dbs-mono"><?php echo $e($d['ip']) ?></td></tr>
                <?php endforeach ?>
            </table>
            <p class="dbs-muted"><?php echo $e($m('revokeHelp')) ?></p>
            <?php echo $this->revokeForm ?>
        <?php endif ?>
    </div>

    <div class="dbs-box">
        <h3><?php echo $e($m('activityTitle')) ?></h3>
        <?php if (!$this->jobs): ?>
            <p class="dbs-muted"><?php echo $e($m('noActivity')) ?></p>
        <?php else: ?>
            <table>
                <tr><th><?php echo $e($m('colStarted')) ?></th><th><?php echo $e($m('colKind')) ?></th>
                    <th><?php echo $e($m('colDevice')) ?></th><th><?php echo $e($m('colState')) ?></th><th><?php echo $e($m('colSize')) ?></th></tr>
                <?php foreach ($this->jobs as $j):
                    $cls = ['done' => 'dbs-ok', 'failed' => 'dbs-err', 'canceled' => 'dbs-muted'][$j['state']] ?? 'dbs-run';
                    $kind = $j['kind'] === 'backup' ? $m('kindBackup') : ($j['mode'] === 'server' ? $m('kindRestore') : $m('kindImport')); ?>
                <tr><td><?php echo $e($when($j['started'])) ?></td><td><?php echo $e($kind) ?></td>
                    <td><?php echo $e($j['device']) ?></td>
                    <td class="<?php echo $cls ?>"><?php echo $e($m('state_' . $j['state'])) ?>
                        <?php if ($j['state'] === 'failed' && $j['error']): ?><br><span class="dbs-muted"><?php echo $e($j['error']) ?></span><?php endif ?></td>
                    <td><?php echo $j['size'] ? $e($size($j['size'])) : '—' ?></td></tr>
                <?php endforeach ?>
            </table>
        <?php endif ?>
        <p class="dbs-muted"><?php echo $e($m('howItWorks')) ?></p>
    </div>
    <p class="dbs-muted">DEV Backup Studio <?php echo $e($this->version) ?></p>
</div>
